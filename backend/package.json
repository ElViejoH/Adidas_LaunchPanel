{
  "name": "adidas-launch-panel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST para la gestión interna de lanzamientos de producto de Adidas.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:container": "node scripts/startContainer.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "node --test"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "jsonwebtoken": "9.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "7.1.4"
  }
}
