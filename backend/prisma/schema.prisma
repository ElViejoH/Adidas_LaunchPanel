generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  APPROVER
  ADMIN
}

enum LaunchStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
}

model User {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  password      String
  role          Role
  createdAt     DateTime        @default(now())
  launches      Launch[]        @relation("LaunchCreator")
  statusChanges StatusHistory[] @relation("StatusChangedBy")

  @@index([role])
}

model Launch {
  id            Int             @id @default(autoincrement())
  name          String
  description   String
  market        String
  launchDate    DateTime
  status        LaunchStatus    @default(DRAFT)
  creatorId     Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  creator       User            @relation("LaunchCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assets        Asset[]
  statusHistory StatusHistory[]

  @@index([creatorId])
  @@index([status])
  @@index([market])
  @@index([launchDate])
  @@index([status, launchDate])
}

model Asset {
  id        Int      @id @default(autoincrement())
  launchId  Int
  name      String
  type      String
  url       String
  createdAt DateTime @default(now())
  launch    Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([launchId])
}

model StatusHistory {
  id             Int          @id @default(autoincrement())
  launchId       Int
  previousStatus LaunchStatus
  newStatus      LaunchStatus
  changedById    Int
  comment        String?
  createdAt      DateTime     @default(now())
  launch         Launch       @relation(fields: [launchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedBy      User         @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([launchId, createdAt])
  @@index([changedById])
}
